# ===================================================================
# AZAMAT AI Hub — Environment Configuration
# Copy this file to .env and fill in your values:  cp .env.example .env
# ===================================================================

# ---------- Required ----------------------------------------------

# Telegram bot token from @BotFather (https://t.me/BotFather)
TELEGRAM_TOKEN=

# Replicate API token (https://replicate.com/account/api-tokens)
REPLICATE_API_TOKEN=

# PostgreSQL connection string, e.g. a free Neon instance (https://neon.tech)
DATABASE_URL=

# ---------- Recommended --------------------------------------------

# Your Telegram user ID — enables admin commands (/set_menu_mode, model reload, ...)
ADMIN_ID=

# HTTPS base URL of this deployment — required for the Telegram Mini App
# e.g. https://your-app.onrender.com
APP_URL=

# ---------- Optional AI backends ------------------------------------

# Enables DALL·E 3 and GPT models
OPENAI_API_KEY=

# ---------- Optional infrastructure ----------------------------------

# Environment label shown in logs (e.g. production, staging, dev)
APP_ENV=dev

# HTTP port for the Flask web server (Mini App + APIs)
PORT=5000

# Max PostgreSQL connections in the pool
DB_MAX_POOL_SIZE=20

# Redis URL (optional caching)
REDIS_URL=

# Verifies Replicate webhook signatures (recommended in production)
REPLICATE_WEBHOOK_SIGNING_SECRET=

# Max parallel Replicate requests
REPLICATE_MAX_CONCURRENT=1

# ---------- Optional ops / monitoring --------------------------------

# Separate bot token used to send periodic status reports
LOG_BOT_ALOSCHA=

# Telegram user ID that receives the status reports (falls back to ADMIN_ID)
LOG_ADMIN_ID=

# Seconds between status reports
LOG_INTERVAL_SECONDS=120

# ---------- Optional legal / imprint (shown in the bot) ---------------

LEGAL_SERVICE_NAME=
IMPRINT_LEGAL_NAME=
IMPRINT_ADDRESS=
IMPRINT_EMAIL=
IMPRINT_PHONE=
IMPRINT_RESPONSIBLE=
IMPRINT_VAT=
IMPRINT_REG=
